{
  "name": "pi-handoff",
  "version": "0.12.0",
  "type": "module",
  "description": "Self-maintaining handoff.md per working directory + git branch for pi, stored under ~/.agent/agent-handoff.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "handoff"
  ],
  "pi": {
    "changelogPath": "./CHANGELOG.md",
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "//peerDependenciesMeta": "Optional peers keep runtime installations on pi's host runtime. Development copies only provide local test and type-check dependencies.",
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
