{
  "name": "@fleetingecho/pi-handoff",
  "version": "1.7.0",
  "type": "module",
  "description": "Automatic per-branch handoffs and reviewed project-wide memory for Pi.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FleetingEcho/pi-handoff.git"
  },
  "homepage": "https://github.com/FleetingEcho/pi-handoff#readme",
  "bugs": {
    "url": "https://github.com/FleetingEcho/pi-handoff/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "*.ts",
    "skills",
    "README.md",
    "DESIGN.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "handoff",
    "memory",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "//peerDependenciesMeta": "Optional so `npm install` does NOT pull a second copy of the pi runtime into the extension clone. Imports are resolved at runtime by pi (jiti) from the installed pi, never from here.",
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
